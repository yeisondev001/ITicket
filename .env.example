# Variables del frontend. Copia este archivo como .env.local y completa los valores.
# Están en Supabase: botón "Connect" del proyecto, o Project Settings > API Keys.
# .env.local no se sube al repo (está en .gitignore).
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
